generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  new
  contacted
  meeting_scheduled
  proposal_sent
  converted
  lost
}

enum InterestLevel {
  none
  interested
  meeting_requested
}

enum LeadSource {
  estimate
  contact
}

enum ServiceKind {
  card
  badge
}

model Lead {
  id          String      @id @default(uuid())
  fullName    String
  email       String
  phone       String
  companyName String?
  projectType String
  description String
  features    String[]
  timeline    String
  budgetRange String?
  source           LeadSource?
  status           LeadStatus     @default(new)
  interestLevel    InterestLevel  @default(none)
  createdAt        DateTime       @default(now())
  estimate         Json?
  srs              Json?
  marketComparison Json?
  quotationToken   String?        @unique
  tokenExpiresAt   DateTime?
  quotationViewed  Boolean        @default(false)
  score            Int            @default(0)
  scoreLabel       String         @default("cold")
  calendlyEventUri String?

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([quotationToken])
  @@index([score(sort: Desc)])
}

model ShowcaseProject {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  category         String
  shortDescription String
  techStack        String[]
  overview         String
  problemSolved    String
  keyFeatures      String[]
  businessValue    String
  costRange        String
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([sortOrder])
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  bio         String
  imageUrl    String?
  linkedInUrl String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([sortOrder])
}

model ServiceItem {
  id          String      @id @default(uuid())
  kind        ServiceKind @default(card)
  title       String
  description String      @default("")
  published   Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([kind, published, sortOrder])
  @@index([sortOrder])
}
