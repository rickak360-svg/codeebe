# NestJS API — copy to .env in this folder
API_PORT=3001

# PostgreSQL (required for leads). Start with: pnpm db:up && pnpm db:migrate
DATABASE_URL=postgresql://codeebe:codeebe@localhost:5432/codeebe

# CORS (optional; defaults include localhost:3000 and :5173)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# Redis / BullMQ (jobs demo). Leads API works without Redis.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Set to false to skip BullMQ when Redis is not running
REDIS_ENABLED=false
