# NestJS API — copy to .env in this folder
API_PORT=3001

# PostgreSQL (required for leads). Start with: pnpm db:up && pnpm db:migrate
DATABASE_URL=postgresql://codeebe:codeebe@localhost:5432/codeebe

# CORS (optional; defaults include localhost:3000 and :5173)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# Redis / BullMQ (jobs demo). Leads API works without Redis.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Set to false to skip BullMQ when Redis is not running
REDIS_ENABLED=false

# Web app public URL (used for quotation links in emails)
WEB_URL=http://localhost:3008

# SMTP — Hostinger example (two mailboxes on your domain)
#   Sending mailbox  -> SMTP_USER / SMTP_FROM (e.g. no-reply@yourdomain.com)
#   Receiving mailbox -> SMTP_REPLY_TO / ADMIN_NOTIFY_EMAIL (e.g. hello@yourdomain.com)
# Hostinger SMTP: host=smtp.hostinger.com, port=465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM="Codeebe <no-reply@yourdomain.com>"
SMTP_REPLY_TO=hello@yourdomain.com
# Set MAIL_ENABLED=false to skip sending emails (logs to console instead)
MAIL_ENABLED=true
ADMIN_NOTIFY_EMAIL=hello@yourdomain.com

# OpenAI — AI-generated SRS, estimate reasoning, and market comparison
# Leave OPENAI_API_KEY empty (or set AI_ENABLED=false) to use template fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# Admin auth — shared password login that issues a JWT for /admin/* + lead management
ADMIN_PASSWORD=change-me-strong-admin-password
JWT_SECRET=change-me-to-a-long-random-secret-string

# WhatsApp via Twilio (optional)
WHATSAPP_ENABLED=false
WHATSAPP_NOTIFY_CLIENT=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ADMIN_TO=whatsapp:+91xxxxxxxxxx

# Calendly webhooks
CALENDLY_WEBHOOK_SIGNING_KEY=
